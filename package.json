{
  "name": "mauzicode",
  "version": "1.0.0",
  "description": "Desktop AI assistant with tool execution",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:html",
    "build:html": "node -e \"require('fs').cpSync('src/renderer/index.html','dist/renderer/index.html')\"",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --outfile=dist/main/index.js --format=cjs --external:electron",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node20 --outfile=dist/main/preload.js --format=cjs --external:electron",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --platform=browser --target=es2020 --outfile=dist/renderer/app.js --format=iife --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:exe": "npm run build && npx electron-builder --win --x64",
    "start": "npm run build && npx electron dist/main/index.js",
    "dev": "npx electron dist/main/index.js",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch{}\""
  },
  "build": {
    "appId": "com.mauzicode.app",
    "productName": "MauziCode",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "MauziCode-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "strip-ansi": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
